                    <connector index="2">HDMI-3</connector>
                    <connector index="3">DP-3</connector>
                </display_connectors>
            </display_configuration>-->
            <vm_pid>vm_pid1</vm_pid>
            <description>Win11 Virtual Machine</description>
        </vm>
