            <description>Win11 Virtual Machine</description>
        </vm>
        <vm id="3">
            <name>ubuntu1</name>
            <os_type>ubuntu</os_type>
            <memory_size>8192</memory_size>
            <cpu_cores>4</cpu_cores>
            <cpu_threads>2</cpu_threads>
	    <!--cpu_assignment>8-11</cpu_assignment>-->
	    <!--usb_mouse_hostbus>003</usb_mouse_hostbus>
	    <usb_mouse_hostport>6.1</usb_mouse_hostport>-->
