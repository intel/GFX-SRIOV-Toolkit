            <disk_path>/data/vm-images/ubuntu24_1.img</disk_path>
            <ssh_port>1103</ssh_port>
            <monitor_port>1113</monitor_port>
            <!--<display_configuration>
                <display_connectors>
                    <connector index="0">HDMI-3</connector>
